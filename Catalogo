<script>
var WA_NUM = "17866364525";
var D = window.CATALOG_DATA;
var estado = { q: "", cat: "Todos", lim: 72 };
var WA_SVG = '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.1 15.3l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3.1 4c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.2 1.7 2.8 4.3 3.8 2.1.8 2.6.7 3 .6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.2-1.5-.7c-.2-.1-.4-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.5-.6c.1-.2.1-.3 0-.5l-.7-1.7c-.2-.5-.4-.4-.5-.4Z"/></svg>';
function linkWa(texto){ return "https://wa.me/" + WA_NUM + "?text=" + encodeURIComponent(texto); }
function waProducto(p){ return linkWa("Hola, me interesa el producto: " + p.nombre + " (C\u00f3d. " + p.id + "). \u00bfTienen disponibilidad?"); }
function esc(s){ var d = document.createElement("div"); d.textContent = s == null ? "" : String(s); return d.innerHTML.replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
function filtrados(){ var q = estado.q.trim().toLowerCase(); return D.productos.filter(function(p){ return (estado.cat === "Todos" || p.categoria === estado.cat) && (!q || p.nombre.toLowerCase().indexOf(q) >= 0 || p.id.toLowerCase().indexOf(q) >= 0); }); }
function pintarChips(){ var cont = document.getElementById("chips"); var conteo = { Todos: D.productos.length }; D.productos.forEach(function(p){ conteo[p.categoria] = (conteo[p.categoria]||0)+1; }); var cats = ["Todos"].concat(D.categorias); cont.innerHTML = cats.map(function(c){ return '<button data-cat="' + esc(c) + '" class="' + (estado.cat === c ? "activa" : "") + '">' + esc(c) + " (" + (conteo[c]||0) + ")</button>"; }).join(""); Array.prototype.forEach.call(cont.querySelectorAll("button"), function(b){ b.onclick = function(){ estado.cat = b.getAttribute("data-cat"); estado.lim = 72; pintar(); }; }); }
function pintar(){ pintarChips(); var f = filtrados(); var vis = f.slice(0, estado.lim); var grid = document.getElementById("grid"); grid.innerHTML = vis.map(function(p){ var img = p.imagenUrl ? '<img loading="lazy" src="' + p.imagenUrl + '" alt="' + esc(p.nombre) + '">' : ""; var meta = p.unidadCaja ? '<div class="meta">Caja: ' + esc(p.unidadCaja) + (p.unidadMedida ? " \u00b7 " + esc(String(p.unidadMedida).replace(/\.$/, "")) : "") + "</div>" : ""; return '<article class="card" data-i="' + D.productos.indexOf(p) + '"><div class="foto">' + img + '<span class="cod">' + esc(p.id) + '</span></div><div class="info"><h3>' + esc(p.nombre) + "</h3>" + meta + '</div><div class="pie"><a target="_blank" rel="noopener" href="' + waProducto(p) + '">' + WA_SVG + " Consultar</a></div></article>"; }).join(""); document.getElementById("conteo").textContent = vis.length + " de " + f.length; document.getElementById("vacio").style.display = f.length ? "none" : "block"; document.getElementById("btnMas").style.display = f.length > estado.lim ? "block" : "none"; Array.prototype.forEach.call(grid.querySelectorAll(".card"), function(c){ c.onclick = function(ev){ if (ev.target.closest("a")) return; abrirFicha(D.productos[+c.getAttribute("data-i")]); }; }); }
function abrirFicha(p){ var specs = [["C\u00f3digo", p.id],["Categor\u00eda", p.categoria],["Unidades por caja", p.unidadCaja],["Unidad de medida", p.unidadMedida],["Volumen (ft\u00b3)", p.ft3],["Volumen (m\u00b3)", p.m3],["Peso por caja (kg)", p.pesoKg],["Marca", p.marca],["Fuente", p.fuente + " \u00b7 p\u00e1g. " + p.pagina]].filter(function(s){ return s[1] != null && s[1] !== ""; }); document.getElementById("fichaCod").textContent = p.id + " \u00b7 " + p.fuente; document.getElementById("fichaImg").innerHTML = p.imagenUrl ? '<img src="' + p.imagenUrl + '" alt="' + esc(p.nombre) + '">' : ""; document.getElementById("fichaCat").textContent = p.categoria; document.getElementById("fichaNombre").textContent = p.nombre; var de = document.getElementById("fichaDesc"); if (p.descripcionEn) { de.style.display = "block"; de.innerHTML = '<b style="color:#22252C">Descripci\u00f3n (EN):</b> ' + esc(p.descripcionEn); } else de.style.display = "none"; document.getElementById("fichaSpecs").innerHTML = specs.map(function(s){ return "<tr><td>" + esc(s[0]) + "</td><td>" + esc(s[1]) + "</td></tr>"; }).join(""); document.getElementById("fichaWa").setAttribute("href", waProducto(p)); document.getElementById("velo").classList.add("abierto"); }
function cerrarFicha(){ document.getElementById("velo").classList.remove("abierto"); }
document.getElementById("buscar").addEventListener("input", function(e){ estado.q = e.target.value; estado.lim = 72; pintar(); });
document.getElementById("btnMas").onclick = function(){ estado.lim += 72; pintar(); };
document.getElementById("btnLimpiar").onclick = function(){ estado.q = ""; estado.cat = "Todos"; estado.lim = 72; document.getElementById("buscar").value = ""; pintar(); };
document.getElementById("velo").onclick = function(e){ if (e.target.id === "velo") cerrarFicha(); };
document.getElementById("fichaCerrar").onclick = cerrarFicha;
window.addEventListener("keydown", function(e){ if (e.key === "Escape") cerrarFicha(); });
document.getElementById("irCatalogo").onclick = function(){ var el = document.getElementById("controles"); window.scrollTo({ top: el.getBoundingClientRect().top + window.pageYOffset - 64, behavior: "smooth" }); };
document.getElementById("totalProd").textContent = D.productos.length;
