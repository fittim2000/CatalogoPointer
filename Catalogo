.wrap{max-width:1240px;margin:0 auto;padding:0 16px}
.topbar{position:sticky;top:0;z-index:40;background:#fff;border-bottom:1px solid #E7E3DC}
.topbar .wrap{display:flex;align-items:center;gap:12px;padding-top:10px;padding-bottom:10px}
.marca{display:flex;align-items:baseline;gap:7px;cursor:pointer}
.marca b{font-weight:900;font-size:21px;letter-spacing:-.5px}.marca b i{color:#C22823;font-style:normal}
.marca small{font-weight:700;font-size:10px;letter-spacing:2.2px;color:#C22823}
.btn-wa{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#1DAB53;color:#fff!important;font-weight:700;font-size:13px;padding:10px 14px;border-radius:999px;min-height:44px}
.btn-wa:hover{background:#178A43}
.hero{background:#22252C;color:#F5F3EF;position:relative;overflow:hidden}
