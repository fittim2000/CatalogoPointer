.hero .wrap{padding-top:52px;padding-bottom:46px;position:relative}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(245,243,239,.25);border-radius:999px;padding:6px 12px;font-size:11px;font-weight:700;letter-spacing:1.6px}
.pill s{width:7px;height:7px;border-radius:50%;background:#C22823;display:inline-block;text-decoration:none}
.hero h1{font-size:clamp(34px,7vw,64px);line-height:.98;font-weight:900;letter-spacing:-1.5px;margin:18px 0 0;text-transform:uppercase}
.hero h1 i{color:#C22823;font-style:normal}
.hero p{margin:16px 0 0;max-width:560px;font-size:15px;line-height:1.55;color:rgba(245,243,239,.78)}
.hero .ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.btn-rojo{background:#C22823;color:#fff!important;border:none;font-family:inherit;font-weight:700;font-size:14px;padding:13px 22px;border-radius:10px;cursor:pointer;min-height:46px}
.btn-rojo:hover{background:#9E1F1B}
.btn-linea{display:inline-flex;align-items:center;gap:8px;background:transparent;color:#F5F3EF!important;border:1px solid rgba(245,243,239,.35);font-weight:700;font-size:14px;padding:13px 20px;border-radius:10px;min-height:46px}
.btn-linea:hover{border-color:#F5F3EF}
.stats{display:flex;flex-wrap:wrap;gap:18px 28px;margin-top:30px;padding-top:22px;border-top:1px solid rgba(245,243,239,.14)}
.stats b{font-weight:900;font-size:20px;display:block}.stats span{font-size:11px;letter-spacing:1.4px;color:rgba(245,243,239,.6);font-weight:600}
.controles{position:sticky;top:65px;z-index:30;background:rgba(245,243,239,.96);backdrop-filter:blur(6px);border-bottom:1px solid #E7E3DC}
.controles .wrap{padding-top:10px;display:flex;flex-direction:column;gap:8px}
.fila-busqueda{display:flex;gap:8px;align-items:center}
#buscar{flex:1;min-height:44px;border:1px solid #D9D4CB;border-radius:10px;padding:0 14px;font-size:14px;background:#fff;color:#22252C}
#conteo{font-size:12px;font-weight:700;color:#6E6A62;white-space:nowrap}
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none}
.chips button{flex-shrink:0;border:1px solid #D9D4CB;background:#fff;color:#22252C;font-family:inherit;font-weight:600;font-size:12.5px;padding:8px 13px;border-radius:999px;cursor:pointer;min-height:36px;white-space:nowrap}
.chips button.activa{background:#22252C;color:#fff;border-color:#22252C}
main{padding:18px 16px 30px;max-width:1240px;margin:0 auto;width:100%}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(164px,1fr));gap:12px}
.card{background:#fff;border:1px solid #E7E3DC;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;animation:fadeUp .35s ease both;cursor:pointer}
.card:hover{border-color:#C9C3B8;box-shadow:0 6px 18px rgba(34,37,44,.08)}
.card .foto{position:relative;background:#fff;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:10px}
.card .foto img{max-width:100%;max-height:100%;object-fit:contain}
.card .cod{position:absolute;top:8px;left:8px;background:#F5F3EF;border:1px solid #E7E3DC;color:#6E6A62;font-size:9.5px;font-weight:700;letter-spacing:.6px;padding:3px 7px;border-radius:6px;white-space:nowrap;max-width:calc(100% - 16px);overflow:hidden;text-overflow:ellipsis}
.card .info{padding:10px 12px 8px;display:flex;flex-direction:column;gap:6px;flex:1}
.card h3{margin:0;font-size:12.5px;line-height:1.3;font-weight:700;text-wrap:pretty}
.card .meta{font-size:11px;color:#6E6A62;font-weight:600}
.card .pie{padding:0 10px 10px}
.card .pie a{display:flex;align-items:center;justify-content:center;gap:7px;background:#1DAB53;color:#fff!important;font-weight:700;font-size:12.5px;min-height:40px;border-radius:9px}
.card .pie a:hover{background:#178A43}
.vacio{text-align:center;padding:70px 20px;color:#6E6A62}
.vacio b{font-weight:900;font-size:22px;color:#22252C;display:block}
.btn-mas{background:#22252C;color:#fff;border:none;font-family:inherit;font-weight:700;font-size:14px;padding:13px 26px;border-radius:10px;cursor:pointer;min-height:46px;display:block;margin:22px auto 0}
.btn-mas:hover{background:#3A3E48}
footer{background:#22252C;color:rgba(245,243,239,.75);margin-top:10px}
footer .wrap{padding-top:26px;padding-bottom:26px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;font-size:12.5px}
footer .nota{font-size:11.5px;color:rgba(245,243,239,.5);max-width:420px}
