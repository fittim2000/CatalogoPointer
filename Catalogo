#velo.abierto{display:flex}
#ficha{background:#fff;width:100%;max-width:720px;max-height:88vh;overflow-y:auto;border-radius:18px 18px 0 0;animation:sheetIn .28s ease both}
#ficha .cab{position:sticky;top:0;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid #E7E3DC;z-index:2}
