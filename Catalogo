*{box-sizing:border-box}html,body{margin:0;padding:0;background:#F5F3EF}
body{font-family:Archivo,"Helvetica Neue",Helvetica,Arial,sans-serif;color:#22252C;-webkit-font-smoothing:antialiased}
a{color:#C22823;text-decoration:none}input{font-family:inherit}input:focus{outline:2px solid #C22823;outline-offset:-1px}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
